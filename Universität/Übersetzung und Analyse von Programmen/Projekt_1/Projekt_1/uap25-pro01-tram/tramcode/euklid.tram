//Variable a
CONST 2
//Variable b
CONST 378
//Prüfe B = 0
EUKLID: LOAD 1 0
IFZERO ENDE
//Prüfe A = 0
LOAD 0 0
IFZERO ENDE2
LOAD 0 0
LOAD 1 0
//A > B
GT
IFZERO ELSE
LOAD 0 0
LOAD 1 0
SUB
LOAD 1 0
INVOKE 2 EUKLID 0
RETURN
HALT
ELSE: LOAD 0 0
LOAD 1 0
LOAD 0 0
SUB
INVOKE 2 EUKLID 0
RETURN
HALT
GOTO ENDE
//B (TOP) zurückgeben
ENDE: LOAD 0 0
RETURN
HALT
//A zurückgeben
ENDE2: LOAD 1 0
RETURN
STOP: HALT