Grammar

Rule 0     S' -> expression
Rule 1     expression -> LET dexpr IN expression
Rule 2     expression -> ID
Rule 3     expression -> ID LPAREN aexpr RPAREN
Rule 4     expression -> expression AOP expression
Rule 5     expression -> LPAREN expression RPAREN
Rule 6     expression -> CONST
Rule 7     expression -> ID ASSIGN expression
Rule 8     expression -> expression SEMI expression
Rule 9     expression -> IF bexpr THEN expression ELSE expression
Rule 10    expression -> WHILE bexpr DO LBRACE expression RBRACE
Rule 11    aexpr -> expression
Rule 12    aexpr -> aexpr COMMA expression
Rule 13    dexpr -> ID LPAREN vexpr RPAREN LBRACE expression RBRACE
Rule 14    dexpr -> dexpr dexpr
Rule 15    vexpr -> ID
Rule 16    vexpr -> vexpr COMMA vexpr
Rule 17    vexpr -> <empty>
Rule 18    bexpr -> LPAREN bexpr RPAREN
Rule 19    bexpr -> BOOL
Rule 20    bexpr -> bexpr LOP bexpr
Rule 21    bexpr -> bexpr EQOP bexpr
Rule 22    bexpr -> expression EQOP expression
Rule 23    bexpr -> expression RELOP expression

