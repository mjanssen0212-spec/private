IF                   : 3
IN                   : 11
LBRACE               : 2 13
LET                  : 11
LOP                  : 7
LPAREN               : 12
RBRACE               : 2 13
RELOP                : 6
RPAREN               : 12
SEMI                 : 10
THEN                 : 3
TRUE                 : 
WHILE                : 2
error                : 

