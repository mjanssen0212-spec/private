ID : Bezeichner = [A-Za-z_][A-Za-z0-9_]*
CONST: Positive, ganze Zahl = 0 | [1-9][0-9]*
AOP: Operatoren (+, -, *, /)
RELOP: Vergleichsoperatoren (<, >, <=, >=)
LOP: Logische Operatoren (||, &&)
BOOL: Booleans (true, false)
EQOP: ==, !=